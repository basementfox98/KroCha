-- ============================================================================
-- CHAT DATA POLLING & RENDERING ENGINE
-- ============================================================================
local function IsMessageVisibleToLocalPlayer(msgData)
    if not msgData.IsPrivate then return true end
    local myName = string.lower(LocalPlayer.Name)
    local senderName = string.lower(msgData.Username or "")
    local targetName = string.lower(msgData.TargetUser or "")
    return (myName == senderName) or (myName == targetName)
end

local function ProcessChatData(rawJson, channelType)
    if not rawJson or type(rawJson) ~= "table" then return end

    local cacheList = (channelType == "GLOBAL") and GlobalCachedMessages or ServerCachedMessages
    local uiList = (channelType == "GLOBAL") and GlobalUIElements or ServerUIElements

    local newMessagesFound = false

    for key, msgData in pairs(rawJson) do
        if type(msgData) == "table" and msgData.Timestamp and msgData.Timestamp >= ScriptStartTime then
            if not cacheList[key] then
                cacheList[key] = msgData

                if IsMessageVisibleToLocalPlayer(msgData) then
                    local card = CreateMessageCard(msgData)
                    card.LayoutOrder = msgData.Timestamp
                    card.Visible = (ActiveTab == channelType)
                    card.Parent = MessageContainer

                    table.insert(uiList, card)
                    newMessagesFound = true

                    if channelType == ActiveTab and ActiveTab == "GLOBAL" then
                        DisplayNewMessageNotif(msgData)
                    end
                end
            end
        end
    end

    if newMessagesFound and MessageContainer.Visible then
        task.defer(function()
            MessageContainer.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y + 12)
            MessageContainer.CanvasPosition = Vector2.new(0, MessageContainer.CanvasSize.Y.Offset)
        end)
    end
end

-- Polling Loop
task.spawn(function()
    while true do
        pcall(function()
            FetchRemoteRoles()
            FetchRemoteRankStyles()

            local globalData = HttpRequest(GLOBAL_MESSAGES_ENDPOINT, "GET")
            if globalData then ProcessChatData(globalData, "GLOBAL") end

            local serverData = HttpRequest(SERVER_MESSAGES_ENDPOINT, "GET")
            if serverData then ProcessChatData(serverData, "SERVER") end
        end)
        task.wait(2.5)
    end
end)

-- ============================================================================
-- SEND MESSAGE & COMMAND PROCESSOR
-- ============================================================================
SendChatMessage = function()
    local text = MessageInput.Text
    if text == "" then return end

    -- Check persistent private prefix
    if PersistentPvtPrefix ~= "" and not string.find(text, PersistentPvtPrefix, 1, true) then
        PersistentPvtPrefix = ""
    end

    local now = tick()

    -- Anti-Spam Check
    if text == LastSentMessageText and (now - LastMessageSendTime) < 3.0 then
        ConsecutiveSpamCount = ConsecutiveSpamCount + 1
        if ConsecutiveSpamCount >= 2 then
            local card = CreateSystemAnnouncementCard("Please refrain from spamming identical messages.")
            card.LayoutOrder = os.time()
            card.Parent = MessageContainer
            MessageInput.Text = PersistentPvtPrefix
            return
        end
    else
        if (now - LastMessageSendTime) >= 3.0 then
            ConsecutiveSpamCount = 0
        end
    end

    LastSentMessageText = text
    LastMessageSendTime = now

    -- Whispers / Private Messaging Command
    local targetWhisperUser, whisperMsg = string.match(text, "^/w%s+([%w_]+)%s+(.+)$")
    if targetWhisperUser and whisperMsg then
        local payload = {
            Username = LocalPlayer.Name,
            DisplayName = SpoofedDisplayName or LocalPlayer.DisplayName,
            Role = GetAssignedOrCalculatedRole(LocalPlayer.Name),
            PfpId = CurrentPfpId,
            Text = whisperMsg,
            Timestamp = os.time(),
            IsPrivate = true,
            TargetUser = targetWhisperUser
        }

        local endpoint = (ActiveTab == "GLOBAL") and GLOBAL_MESSAGES_ENDPOINT or SERVER_MESSAGES_ENDPOINT
        HttpRequest(endpoint, "POST", payload)

        MessageInput.Text = PersistentPvtPrefix
        return
    end

    -- Role / Tag Switch Commands (!tag / !role)
    local cmdTag, argTag = string.match(text, "^(!%a+)%s+(.+)$")
    if cmdTag and (string.lower(cmdTag) == "!tag" or string.lower(cmdTag) == "!role") then
        local desiredTag = argTag
        local targetRole = nil

        for rankName, _ in pairs(RANK_STYLES) do
            if string.lower(rankName) == string.lower(desiredTag) then
                targetRole = rankName
                break
            end
        end

        if targetRole then
            local encodedId = EncodePlayerId(LocalPlayer.UserId)
            local myRoles = AvailableUserRoles[LocalPlayer.Name] or {}
            
            local restrictedList = {
                ["architect"] = true,
                ["overseer"] = true,
                ["critic"] = true,
                ["og"] = true,
                ["hacker"] = true,
                ["god"] = true,
                ["regent of codes"] = true,
                ["regent of clans"] = true,
                ["regent of havoc"] = true,
                ["serial killer"] = true,
                ["serial killer🔪"] = true
            }

            local tagLower = string.lower(targetRole)
            local isRestricted = restrictedList[tagLower] ~= nil

            if isRestricted then
                -- Check github repo RoleListNew.js restrictions
                if CanUserSwitchToRestrictedTag(targetRole, LocalPlayer.Name, encodedId) then
                    AssignedPlayerRoles[LocalPlayer.Name] = targetRole
                    local card = CreateSystemAnnouncementCard("Your active tag has been updated to: " .. targetRole)
                    card.LayoutOrder = os.time()
                    card.Parent = MessageContainer
                else
                    local card = CreateSystemAnnouncementCard("Access Denied: You are not authorized to use the '" .. targetRole .. "' tag.")
                    card.LayoutOrder = os.time()
                    card.Parent = MessageContainer
                end
            else
                -- Unrestricted roles logic
                if HasAdminPermission(LocalPlayer.Name) or table.find(myRoles, targetRole) or targetRole == "VIP" or targetRole == "ELITE" or targetRole == "Recruit" or targetRole == "Agent" then
                    AssignedPlayerRoles[LocalPlayer.Name] = targetRole
                    local card = CreateSystemAnnouncementCard("Your active tag has been updated to: " .. targetRole)
                    card.LayoutOrder = os.time()
                    card.Parent = MessageContainer
                else
                    local card = CreateSystemAnnouncementCard("You do not own the role '" .. targetRole .. "'. Submit a request in the About tab!")
                    card.LayoutOrder = os.time()
                    card.Parent = MessageContainer
                end
            end
        else
            local card = CreateSystemAnnouncementCard("Role/Tag '" .. desiredTag .. "' was not found in the registry.")
            card.LayoutOrder = os.time()
            card.Parent = MessageContainer
        end

        MessageInput.Text = ""
        return
    end

    -- Spoof Display Name Command (!spoof)
    local cmdSpoof, argSpoof = string.match(text, "^(!spoof)%s+(.+)$")
    if cmdSpoof then
        if CanUseSpoof(LocalPlayer.Name) then
            SpoofedDisplayName = argSpoof
            WelcomeLabel.Text = "Welcome, " .. GetFormattedDisplayName(LocalPlayer.DisplayName, true)
            local card = CreateSystemAnnouncementCard("Spoofed DisplayName set to: " .. argSpoof)
            card.LayoutOrder = os.time()
            card.Parent = MessageContainer
        else
            local card = CreateSystemAnnouncementCard("You lack permissions to execute the !spoof command.")
            card.LayoutOrder = os.time()
            card.Parent = MessageContainer
        end

        MessageInput.Text = ""
        return
    end

    -- Standard Chat Message Dispatch
    local activeRole = GetAssignedOrCalculatedRole(LocalPlayer.Name)
    local payload = {
        Username = LocalPlayer.Name,
        DisplayName = SpoofedDisplayName or LocalPlayer.DisplayName,
        Role = activeRole,
        PfpId = CurrentPfpId,
        Text = text,
        Timestamp = os.time(),
        IsPrivate = false
    }

    local endpoint = (ActiveTab == "GLOBAL") and GLOBAL_MESSAGES_ENDPOINT or SERVER_MESSAGES_ENDPOINT
    HttpRequest(endpoint, "POST", payload)

    MessageInput.Text = PersistentPvtPrefix
end

