local function UpdateAutocomplete()
    local text = MessageInput.Text
    local cursorPosition = MessageInput.CursorPosition
   
    if cursorPosition < 1 then
        AutocompleteBox.Visible = false
        return
    end

    local textUpToCursor = string.sub(text, 1, cursorPosition - 1)
    local currentWord = string.match(textUpToCursor, "(%S+)$") or ""

    if currentWord == "" or string.len(currentWord) < 1 then
        AutocompleteBox.Visible = false
        return
    end

    for _, child in ipairs(AutocompleteBox:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    local matches = {}
    local currentWordLower = string.lower(currentWord)

    for _, option in ipairs(ALL_AUTOCOMPLETE_OPTIONS) do
        if string.lower(option) ~= currentWordLower and string.find(string.lower(option), currentWordLower, 1, true) == 1 then
            table.insert(matches, option)
        end
    end

    if #matches == 0 then
        AutocompleteBox.Visible = false
        return
    end

    local maxShow = math.min(#matches, 5)
    for i = 1, maxShow do
        local optionText = matches[i]
        local optionBtn = Instance.new("TextButton")
        optionBtn.Size = UDim2.new(1, 0, 0, 22)
        optionBtn.BackgroundTransparency = 1
        optionBtn.Font = Enum.Font.GothamBold
        optionBtn.Text = "  " .. optionText
        optionBtn.TextColor3 = Color3.fromRGB(220, 220, 230)
        optionBtn.TextSize = 10
        optionBtn.TextXAlignment = Enum.TextXAlignment.Left
        optionBtn.ZIndex = 21
        optionBtn.Parent = AutocompleteBox

        optionBtn.MouseButton1Click:Connect(function()
            local prefix = string.sub(textUpToCursor, 1, #textUpToCursor - #currentWord)
            local suffix = string.sub(text, cursorPosition)
           
            local addition = optionText
            if string.sub(addition, 1, 1) ~= "!" and string.sub(addition, 1, 1) ~= "/" then
                addition = addition .. " "
            end
           
            MessageInput.Text = prefix .. addition .. suffix
            MessageInput.CursorPosition = #prefix + #addition + 1
            AutocompleteBox.Visible = false
            MessageInput:CaptureFocus()
        end)
    end

    AutocompleteBox.Size = UDim2.new(0, 200, 0, maxShow * 24)
    AutocompleteBox.Visible = true
end

MessageInput:GetPropertyChangedSignal("Text"):Connect(UpdateAutocomplete)
MessageInput:GetPropertyChangedSignal("CursorPosition"):Connect(UpdateAutocomplete)

MessageInput.FocusLost:Connect(function(enterPressed)
    task.delay(0.2, function()
        AutocompleteBox.Visible = false
    end)
    if enterPressed and SendChatMessage then
        SendChatMessage()
    end
end)

